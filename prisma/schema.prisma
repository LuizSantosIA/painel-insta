// Schema do painel de gestão do Instagram.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Um post (ou story) do Instagram com suas métricas.
// SQLite não tem enum nativo, então mediaType/category/source são String.
model Post {
  id           String   @id @default(cuid())
  igId         String?  @unique // id da mídia na Graph API (null = manual)
  caption      String?
  mediaType    String // IMAGE | VIDEO | CAROUSEL_ALBUM | REELS | STORY
  category     String? // tema definido por você: "Dica", "Bastidores", "Promo"...
  permalink    String?
  mediaUrl     String?
  thumbnailUrl String?
  postedAt     DateTime

  // Métricas
  likes           Int @default(0)
  comments        Int @default(0)
  saves           Int @default(0)
  shares          Int @default(0)
  reach           Int @default(0)
  impressions     Int @default(0)
  videoViews      Int @default(0)
  followersAtPost Int @default(0) // seguidores no momento do post (p/ taxa de engajamento)

  // Pipeline editorial. Os posts vindos do Instagram nascem PUBLICADO — ideia,
  // rascunho e agendado existem para o conteúdo planejado dentro do Command Center.
  // IDEIA | RASCUNHO | AGENDADO | PUBLICADO
  status       String    @default("PUBLICADO")
  agendadoPara DateTime? // quando o conteúdo deve ir ao ar; null nos já publicados

  // ─── Máquina de conteúdo ───
  // etapa é a granularidade fina do pipeline de agentes; status continua sendo o
  // que Conteúdo e Calendário leem e é derivado dela (ver lib/engine/etapas.ts).
  // RADAR | IDEIA | SELECIONADA | COPY | DESIGN | REVISAO | AGUARDANDO_APROVACAO |
  // AGENDADO | PUBLICADO | ANALISE | REPROVADO
  etapa             String?
  tituloInterno     String?
  tipoConteudo      String? // VIRAL_ADAPTADO | ORIGINAL | AUTORIDADE | EMPRESA
  objetivo          String? // ALCANCE | AUTORIDADE | CONVERSAO
  tema              String?
  scoreEstrategia   String? // JSON: { viralidade, fit, producao, valor, conversao, media }
  scoreFinal        Int?
  legendaFinal      String?
  palavraChave      String? // CTA "Comente X" — vira AutoRule no lead magnet
  horarioSugerido   DateTime?
  geradoPelaMaquina Boolean               @default(false)
  fonteId           String?
  fonte             FonteConteudo?        @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  estiloVisualId    String?
  estiloVisual      EstiloVisual?         @relation(fields: [estiloVisualId], references: [id], onDelete: SetNull)
  slides            PostSlide[]
  execucoes         ExecucaoAgente[]
  revisoes          RevisaoConteudo[]
  snapshots         PostMetricaSnapshot[]
  aprendizados      Aprendizado[]
  autoRules         AutoRule[]

  source    String   @default("manual") // manual | csv | instagram
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postedAt])
  @@index([mediaType])
  @@index([category])
  @@index([status])
  @@index([etapa])
}

// Snapshot diário da conta para o gráfico de evolução de seguidores.
model AccountSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique
  followers Int
  follows   Int      @default(0)
  reach     Int      @default(0)
  createdAt DateTime @default(now())
}

// Regra de automação: quando keyword aparecer num comentário, dispara replyText.
model AutoRule {
  id           String  @id @default(cuid())
  name         String  @default("")
  keywords     String // palavras-chave separadas por vírgula
  replyText    String  @default("") // resposta pública no comentário (vazio = não responde)
  sendDm       Boolean @default(false)
  dmText       String  @default("") // texto do direct
  mediaId      String? // id da mídia (igId) à qual a regra se restringe; null = todos os posts
  isActive     Boolean @default(true)
  triggerCount Int     @default(0)
  createLead   Boolean @default(false) // se true, cria Lead quando a regra dispara
  leadLinha    String? // INNOBI | MENTORIA | SERVICOS — obrigatório se createLead=true

  // Gatilho: de onde a regra pode disparar.
  // COMENTARIO (padrão, comportamento antigo) | DM (direct e resposta de story) | AMBOS
  gatilho String @default("COMENTARIO")

  // ─── Trava de seguidor ("siga para liberar o link") ───
  exigirSeguir    Boolean      @default(false)
  linkLiberado    String       @default("") // URL entregue depois que a pessoa segue
  gateAskText     String       @default("") // mensagem pedindo o follow
  gateButtonLabel String       @default("Seguindo") // título do quick reply (máx. 20 chars)
  gateDeliverText String       @default("") // mensagem de entrega do link
  gateLinkLabel   String       @default("Acessar") // título do botão web_url (máx. 20 chars)
  postId          String? // post da máquina que gerou esta regra (antes de existir igId)
  post            Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  logs            CommentLog[]
  gates           FollowGate[]
  leads           Lead[]

  @@index([mediaId])
}

// Estado da trava de seguidor, por pessoa + regra.
// PENDING = já pedimos o follow e estamos esperando o clique no botão.
// DELIVERED = já confirmamos o follow e entregamos o link.
model FollowGate {
  id          String    @id @default(cuid())
  igsid       String // Instagram-scoped ID de quem vai receber o link
  ruleId      String
  rule        AutoRule  @relation(fields: [ruleId], references: [id])
  status      String    @default("PENDING") // PENDING | DELIVERED
  attempts    Int       @default(0) // quantas vezes a pessoa clicou sem estar seguindo
  username    String    @default("")
  origem      String    @default("COMENTARIO") // COMENTARIO | DM
  postId      String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([igsid, ruleId])
  @@index([igsid])
}

// Idempotência dos webhooks de mensagem — o Meta reenvia o mesmo mid em caso de falha.
model DmEvent {
  id        String   @id @default(cuid())
  mid       String   @unique
  igsid     String
  text      String   @default("")
  createdAt DateTime @default(now())
}

// Log de cada comentário processado pelas regras.
model CommentLog {
  id          String    @id @default(cuid())
  igCommentId String    @unique
  igPostId    String
  text        String
  username    String    @default("")
  senderId    String    @default("") // IGSID do comentarista (para DM)
  repliedAt   DateTime?
  dmSentAt    DateTime?
  ruleId      String?
  rule        AutoRule? @relation(fields: [ruleId], references: [id])
  createdAt   DateTime  @default(now())

  // A atribuição da Máquina agrupa por post e cruza o comentarista com a conversa
  // no direct — sem estes índices a varredura cresce junto com o histórico.
  @@index([igPostId])
  @@index([senderId])
}

// ─── CRM ────────────────────────────────────────────────────────────────────

model Client {
  id              String        @id @default(cuid())
  name            String
  email           String?
  phone           String?
  instagram       String?
  company         String?
  notes           String?
  status          String        @default("lead") // lead | active | inactive | lost
  source          String? // instagram | whatsapp | referral | organic | other
  tags            String? // separadas por vírgula
  ultimoContatoEm DateTime? // atualizado manualmente via "Registrar contato" na tela de Saúde
  saudeNota       String? // nota interna sobre a situação do cliente
  saudeStatus     String? // última classificação da engine de saúde — só para detectar transição
  saudeAvaliadaEm DateTime? // quando a saúde foi avaliada pela última vez
  arquivadoEm     DateTime? // arquivar preserva o histórico; excluir apaga
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deals           Deal[]
  tasks           Task[]
  receitas        Receita[]
  leads           Lead[]
  compromissos    Compromisso[]
  interacoes      Interacao[]

  @@index([arquivadoEm])
}

model Deal {
  id        String    @id @default(cuid())
  title     String
  value     Float     @default(0)
  stage     String    @default("lead") // lead | contacted | proposal | negotiation | won | lost
  notes     String?
  dueDate   DateTime?
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([stage])
  @@index([clientId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  priority    String    @default("medium") // low | medium | high
  concluidaEm DateTime? // preenchido ao marcar como feita — histórico daqui para frente
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([done])
  @@index([dueDate])
  @@index([clientId])
}

// ─── Pipeline de Leads ───────────────────────────────────────────────────────

// estagio: LEAD | QUALIFICADO | PROPOSTA_ENVIADA | NEGOCIACAO | FECHADO | PERDIDO
// origem:  INSTAGRAM_DM | INSTAGRAM_COMENTARIO | WHATSAPP | EMAIL | INDICACAO | OUTRO
// linhaInteresse: INNOBI | MENTORIA | SERVICOS
// proximaAcao + proximaAcaoEm: obrigatórios para estágios ativos (validados na API)

model Lead {
  id                    String          @id @default(cuid())
  nome                  String
  contato               String
  estagio               String          @default("LEAD")
  origem                String
  linhaInteresse        String
  valorEstimadoCentavos Int?
  proximaAcao           String?
  proximaAcaoEm         DateTime?
  postOrigemId          String? // igId da mídia que originou o lead (Post.igId)
  conversaId            String? // conversa do direct que virou este lead
  conversa              IgConversation? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  automacaoId           String? // automação que trouxe a pessoa para a conversa
  automacao             AutoRule?       @relation(fields: [automacaoId], references: [id], onDelete: SetNull)
  notas                 String?
  clienteId             String? // vínculo opcional: nem todo lead virou cliente
  cliente               Client?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  estagioDesde          DateTime? // quando entrou no estágio atual — null nos leads anteriores
  motivoPerda           String? // PRECO | SEM_RESPOSTA | TIMING | CONCORRENTE | NAO_FIT | DESISTIU | OUTRO
  notaPerda             String?
  criadoEm              DateTime        @default(now())
  atualizadoEm          DateTime        @updatedAt
  // Receitas geradas ao fechar esta oportunidade. A existência de qualquer uma
  // delas é o que impede o fechamento de gerar receita duas vezes.
  receitas              Receita[]

  @@index([estagio, proximaAcaoEm])
  @@index([clienteId])
  @@index([postOrigemId])
  @@index([conversaId])
}

// ─── Compromissos ─────────────────────────────────────────────────────────────

// Promessas feitas a terceiros — mais críticas que tarefas internas.
// Um compromisso vencido não cumprido danifica a relação.

model Compromisso {
  id           String    @id @default(cuid())
  descricao    String
  para         String // nome, @handle ou "cliente X" — para quem foi a promessa
  prazoEm      DateTime
  cumprido     Boolean   @default(false)
  cumpridoEm   DateTime?
  notas        String?
  clienteId    String? // vínculo opcional: nem toda promessa é para um cliente
  cliente      Client?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([cumprido, prazoEm])
  @@index([clienteId])
}

// Registro do que já aconteceu com um cliente. Não confundir com Task/Compromisso,
// que são coisas a fazer.
// tipo: LIGACAO | WHATSAPP | EMAIL | REUNIAO | NOTA | STATUS | SAUDE
// STATUS e SAUDE são gravados pelo sistema (mudança de status do cliente e mudança
// de classificação de saúde). Só LIGACAO/WHATSAPP/EMAIL/REUNIAO contam como contato
// para efeito de diagnóstico — ver TIPOS_CONTATO em src/lib/saude.ts.
model Interacao {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Client   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo      String
  nota      String   @default("")
  ocorreuEm DateTime @default(now())
  criadoEm  DateTime @default(now())

  @@index([clienteId, ocorreuEm])
}

// ─── Financeiro ──────────────────────────────────────────────────────────────

// linha: INNOBI | MENTORIA | SERVICOS
// tipo:  RECORRENTE | PONTUAL
// status gravado: PREVISTA | CONFIRMADA | RECEBIDA | INADIMPLENTE | CANCELADA
// SQLite não suporta enum nativo — valores validados na camada de API (Zod).
//
// "Vencida" NÃO é status gravado: deriva de vencimento < hoje && não recebida.
// A regra mora em statusEfetivo(), em src/lib/financeiro.ts, e é a única do sistema.

model Receita {
  id            String    @id @default(cuid())
  descricao     String
  valorCentavos Int // NUNCA Float — dinheiro sempre em centavos
  linha         String // INNOBI | MENTORIA | SERVICOS
  tipo          String // RECORRENTE | PONTUAL
  status        String    @default("PREVISTA")
  clienteId     String?
  cliente       Client?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  competencia   DateTime // sempre dia 1 do mês, UTC — o mês a que a receita pertence
  // Quando o dinheiro deve entrar. Null nas receitas anteriores a este campo: aí
  // vale o último dia da competência (ver vencimentoEfetivo()).
  vencimento    DateTime?
  dataRecebida  DateTime?
  // Oportunidade que originou a receita — chave de idempotência do fluxo
  // Pipeline → Financeiro: com receita já vinculada, fechar de novo não duplica.
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // Agrupa as competências mensais da mesma recorrência (o "contrato"). A primeira
  // receita da série carrega o próprio id; as réplicas dos meses seguintes repetem-no.
  contratoId    String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  @@index([competencia, status])
  @@index([linha])
  @@index([vencimento])
  @@index([leadId])
  @@index([contratoId])
}

// categoria: FERRAMENTAS | PRESTADORES | IMPOSTOS | ANUNCIOS | INFRA | OUTROS
model Despesa {
  id            String   @id @default(cuid())
  descricao     String
  valorCentavos Int
  recorrente    Boolean  @default(false)
  categoria     String   @default("OUTROS")
  competencia   DateTime // sempre dia 1 do mês, UTC
  criadoEm      DateTime @default(now())

  @@index([competencia])
}

// Configurações globais — singleton (id = "singleton")
model Config {
  id               String   @id @default("singleton")
  saldoCaixa       Int      @default(0) // centavos — informado manualmente
  // Máquina de conteúdo. MANUAL | COPILOTO | AUTOPILOT — só AUTOPILOT publica sozinho.
  modoMaquina      String   @default("COPILOTO")
  tetoExecucoesDia Int      @default(60) // execuções de agente por dia antes de a máquina parar
  atualizadoEm     DateTime @updatedAt
}

// ─── Instagram DMs ───────────────────────────────────────────────────────────

model IgConversation {
  id         String      @id
  igUserId   String      @default("")
  igUsername String      @default("")
  updatedAt  DateTime
  syncedAt   DateTime    @default(now())
  messages   IgMessage[]
  leads      Lead[]

  @@index([updatedAt])
  @@index([igUserId])
}

model IgMessage {
  id             String         @id
  conversationId String
  conversation   IgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  text           String         @default("")
  fromMe         Boolean        @default(false)
  fromUsername   String         @default("")
  createdAt      DateTime
  syncedAt       DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ─── Auto Posts ──────────────────────────────────────────────────────────────

// ─── Máquina de conteúdo ─────────────────────────────────────────────────────

// O que o Radar encontrou. Nunca vira post sozinho — o Estrategista decide.
model FonteConteudo {
  id             String    @id @default(cuid())
  url            String
  titulo         String?
  autor          String?
  plataforma     String? // instagram | x | youtube | blog | newsletter | github | outro
  publicadoEm    DateTime?
  tema           String?
  formato        String? // carrossel | reels | artigo | thread | video
  sinais         String? // JSON: { likes?, comentarios?, compartilhamentos?, views? } — só o que estava visível
  resumo         String?
  porQueFunciona String?
  analise        String? // JSON do Viral Adapter: hook, promessa, mecanismo, estrutura, cta
  conteudoBruto  String? // texto extraído da página, para os agentes lerem
  origem         String    @default("MANUAL") // MANUAL (link colado) | BUSCA | INTERNO
  descartada     Boolean   @default(false)
  criadoEm       DateTime  @default(now())
  posts          Post[]

  @@index([criadoEm])
}

// Um slide do carrossel. Gerado e regenerado individualmente, com versão.
model PostSlide {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  ordem        Int
  headline     String   @default("")
  corpo        String   @default("")
  microcopy    String   @default("")
  layout       String   @default("TEXTO") // chave do layout dentro do estilo visual
  promptVisual String? // direção do Diretor Visual para este slide
  imagemUrl    String? // PNG 1080x1350 no Blob
  assetUrl     String? // elemento ilustrativo gerado (quando o estilo pede)
  versao       Int      @default(1)
  atualizadoEm DateTime @updatedAt

  @@unique([postId, ordem])
}

// Sistema visual reutilizável — o template de código é escolhido pela chave.
model EstiloVisual {
  id            String   @id @default(cuid())
  chave         String   @unique // EDITORIAL_ORANGE | BLUE_TECH | MINIMAL_EDITORIAL | VOXEL_TECH
  nome          String
  descricao     String   @default("")
  paleta        String   @default("{}") // JSON { fundo, texto, destaque, secundaria }
  tipografia    String   @default("")
  regras        String   @default("") // texto livre lido pelo Diretor Visual
  referenciaUrl String? // carrossel de referência analisado
  usaAsset      Boolean  @default(false) // precisa de elemento gerado por modelo de imagem
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  posts         Post[]
}

// Cada chamada de agente. É a resposta para "quem criou, com que prompt, por quê".
model ExecucaoAgente {
  id         String   @id @default(cuid())
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  slideOrdem Int?
  agente     String // RADAR | ESTRATEGISTA | VIRAL_ADAPTER | COPYWRITER | DIRETOR_VISUAL | GERADOR | FACT_CHECKER | LEAD_MAGNET | REVISOR | PUBLICADOR | PERFORMANCE
  etapa      String?
  status     String   @default("OK") // OK | ERRO | ALERTA
  entrada    String   @default("{}") // JSON
  saida      String   @default("{}") // JSON
  prompt     String   @default("")
  modelo     String   @default("")
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  duracaoMs  Int      @default(0)
  erro       String?
  criadoEm   DateTime @default(now())

  @@index([postId, criadoEm])
  @@index([agente, criadoEm])
  @@index([criadoEm])
}

// Sua decisão sobre um post. Motivo vira aprendizado.
model RevisaoConteudo {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  decisao  String // APROVADO | REPROVADO | ALTERACAO
  escopo   String   @default("POST") // POST | SLIDE:n | COPY | LEGENDA | VISUAL
  motivo   String   @default("")
  criadoEm DateTime @default(now())

  @@index([postId, criadoEm])
}

// Métricas em janelas fixas depois da publicação — o Post só guarda o valor atual.
model PostMetricaSnapshot {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  janela      String // 24H | 72H | 7D
  likes       Int      @default(0)
  comments    Int      @default(0)
  saves       Int      @default(0)
  shares      Int      @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  leads       Int      @default(0)
  coletadoEm  DateTime @default(now())

  @@unique([postId, janela])
}

// O que a máquina aprendeu — do seu feedback ou da performance. Entra nos prompts.
model Aprendizado {
  id       String   @id @default(cuid())
  origem   String // FEEDBACK | PERFORMANCE
  texto    String
  tags     String   @default("") // separadas por vírgula: hook, visual, cta, tema…
  peso     Int      @default(1)
  ativo    Boolean  @default(true)
  postId   String?
  post     Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  criadoEm DateTime @default(now())

  @@index([ativo, criadoEm])
}
